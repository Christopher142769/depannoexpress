{
  "expo": {
    "name": "Dépannage Express",
    "slug": "depannage-express",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "depannage-express",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "bj.depannageexpress.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Votre position est utilisée pour signaler une panne et afficher le suivi du dépanneur."
      }
    },
    "android": {
      "package": "bj.depannageexpress.app",
      "adaptiveIcon": {
        "backgroundColor": "#1e73be",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Autorisez Dépannage Express à utiliser votre position pour signaler une panne."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
