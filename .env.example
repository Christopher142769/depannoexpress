# Carte (Mapbox — fallback Leaflet/OSM si absent)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Supabase Realtime (fallback optionnel)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
