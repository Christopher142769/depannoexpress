# MongoDB
MONGODB_URI=mongodb://localhost:27017/depannage-express

# E-mail (OTP + notifications) — jamais SMS
# Providers : nodemailer | resend | console (log serveur, sans SMTP)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@depannage-express.bj
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# Session / JWT (Phase 2 — cookie httpOnly de-session)
# Générer une chaîne aléatoire longue (ex. openssl rand -base64 48)
SESSION_SECRET=change-me-to-a-long-random-secret

# Temps réel — Option B : Supabase Realtime
NEXT_PUBLIC_REALTIME_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role (serveur uniquement — ne jamais exposer au client)
SUPABASE_SERVICE_ROLE_KEY=

# Socket.io (Option A — non utilisée si provider=supabase)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Carte (Mapbox — fallback Leaflet/OSM si absent)
NEXT_PUBLIC_MAPBOX_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
